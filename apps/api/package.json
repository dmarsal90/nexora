{
  "name": "@nexora/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup src/server.ts src/scripts/bootstrap-admin.ts --format esm --target node24 --out-dir dist --clean",
    "start": "node dist/server.js",
    "bootstrap-admin": "tsx src/scripts/bootstrap-admin.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@nexora/database": "workspace:*",
    "@nexora/security": "workspace:*",
    "argon2": "^0.44.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "mongoose": "^8.19.0",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "redis": "^5.8.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  }
}
