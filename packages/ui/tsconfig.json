{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@nexora/ui/components/*": ["./components/*"],
      "@nexora/ui/hooks/*": ["./hooks/*"],
      "@nexora/ui/utils/*": ["./utils/*"]
    }
  },
  "include": ["components", "hooks", "utils"]
}
