# Copy to .env for local Compose. Never use these placeholders in production.
NODE_ENV=development
PORT=4000
WEB_PORT=8080
WEB_ORIGIN=http://localhost:5173
SESSION_COOKIE_SECURE=false
TRUST_PROXY=false
SESSION_IDLE_MINUTES=30
LOG_LEVEL=info

# Local-only credentials. Change them before the first Compose run.
MONGO_INITDB_ROOT_USERNAME=nexora_dev
MONGO_INITDB_ROOT_PASSWORD=replace-with-a-long-random-local-password
MONGO_REPLICA_SET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
MONGODB_URI=mongodb://nexora_dev:replace-with-a-long-random-local-password@mongodb:27017/nexora?authSource=admin&replicaSet=rs0
REDIS_PASSWORD=replace-with-another-long-random-local-password
REDIS_URL=redis://:replace-with-another-long-random-local-password@redis:6379

# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=replace-with-64-hex-characters

# One-time bootstrap profile; use your own email and a password of at least 16 chars.
BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-16-characters
BOOTSTRAP_ORGANIZATION_NAME=Nexora
